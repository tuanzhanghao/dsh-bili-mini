{
  "name": "dsh-bili-mini",
  "version": "0.2.0",
  "type": "module",
  "main": "./index.js",
  "description": "BiliMini — a geeky Bilibili sidebar for DeepSeek Harness (DSH) with DASH 1080P, danmaku and local QR login.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bili.js",
    "danmaku.js",
    "auth.js",
    "trust.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "tuanzhanghao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuanzhanghao/dsh-bili-mini.git"
  },
  "homepage": "https://github.com/tuanzhanghao/dsh-bili-mini#readme",
  "bugs": {
    "url": "https://github.com/tuanzhanghao/dsh-bili-mini/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "bilibili-plugin",
    "danmaku",
    "dash",
    "dashjs",
    "artplayer",
    "electron",
    "sidebar"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check bili.js && node --check auth.js && node --check trust.js && node --check danmaku.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  }
}
